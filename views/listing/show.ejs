<% layout("layouts/boilerplate") %>

<div class="container mt-5 mb-5">

    <!-- ==================================================
         BACK
    ================================================== -->

    <div class="mb-4">

        <a
            href="/listing"
            class="text-decoration-none text-dark"
        >

            <i class="fa-solid fa-arrow-left me-2"></i>

            Back to Listings

        </a>

    </div>


    <!-- ==================================================
         TITLE
    ================================================== -->

    <div class="mb-4">

        <h1 class="fw-bold mb-2">

            <%= listing.title %>

        </h1>

        <p class="text-muted mb-0">

            <i class="fa-solid fa-location-dot me-1"></i>

            <%= listing.location %>,
            <%= listing.country %>

        </p>

    </div>


    <!-- ==================================================
         IMAGE
    ================================================== -->

    <% if (
        listing.image &&
        listing.image.url
    ) { %>

        <img
            src="<%= listing.image.url %>"
            alt="<%= listing.title %>"
            class="img-fluid w-100 mb-5"
            style="
                height:500px;
                object-fit:cover;
                border-radius:20px;
            "
        >

    <% } else { %>

        <div
            class="
                w-100
                mb-5
                bg-light
                d-flex
                align-items-center
                justify-content-center
            "
            style="
                height:500px;
                border-radius:20px;
            "
        >

            <div class="text-center text-muted">

                <i
                    class="
                        fa-solid
                        fa-image
                        fa-3x
                        mb-3
                    "
                ></i>

                <h5>
                    No image available
                </h5>

            </div>

        </div>

    <% } %>


    <!-- ==================================================
         MAIN ROW
    ================================================== -->

    <div class="row g-5">


        <!-- ==================================================
             LEFT
        ================================================== -->

        <div class="col-lg-8">


            <!-- ==================================================
                 HOST
            ================================================== -->

            <div
                class="
                    d-flex
                    justify-content-between
                    align-items-start
                    border-bottom
                    pb-4
                    mb-4
                "
            >

                <div>

                    <h2 class="fw-bold">

                        <%= listing.propertyType %>

                        hosted by

                        <%= listing.owner
                            ? listing.owner.username
                            : "Wanderlust Host"
                        %>

                    </h2>


                    <p class="text-muted mb-0">

                        <i
                            class="
                                fa-solid
                                fa-users
                                me-2
                            "
                        ></i>

                        Up to
                        <%= listing.maxGuests %>
                        guests

                    </p>

                </div>


                <!-- ==================================================
                     WISHLIST
                ================================================== -->

                <% if (currentUser) { %>

                    <%
                        const isSaved =
                            currentUser.wishlist &&
                            currentUser.wishlist.some(
                                id =>
                                    id.toString() ===
                                    listing._id.toString()
                            );
                    %>


                    <% if (isSaved) { %>

                        <form
                            action="/listing/<%= listing._id %>/wishlist?_method=DELETE"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="
                                    btn
                                    btn-danger
                                    rounded-pill
                                "
                            >

                                ❤️ Saved

                            </button>

                        </form>

                    <% } else { %>

                        <form
                            action="/listing/<%= listing._id %>/wishlist"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="
                                    btn
                                    btn-outline-danger
                                    rounded-pill
                                "
                            >

                                ♡ Save

                            </button>

                        </form>

                    <% } %>

                <% } %>

            </div>


            <!-- ==================================================
                 DESCRIPTION
            ================================================== -->

            <div class="mb-5">

                <h3 class="fw-bold mb-3">

                    About this place

                </h3>


                <p
                    class="text-muted"
                    style="
                        line-height:1.8;
                    "
                >

                    <%= listing.description %>

                </p>

            </div>


            <!-- ==================================================
                 PROPERTY DETAILS
            ================================================== -->

            <div class="mb-5">

                <h3 class="fw-bold mb-4">

                    Property Details

                </h3>


                <div class="row g-3">


                    <!-- PROPERTY -->

                    <div class="col-md-6">

                        <div
                            class="
                                border
                                rounded-4
                                p-3
                                h-100
                            "
                        >

                            🏠

                            <strong>
                                Property Type
                            </strong>

                            <div class="text-muted mt-1">

                                <%= listing.propertyType %>

                            </div>

                        </div>

                    </div>


                    <!-- GUESTS -->

                    <div class="col-md-6">

                        <div
                            class="
                                border
                                rounded-4
                                p-3
                                h-100
                            "
                        >

                            👥

                            <strong>
                                Maximum Guests
                            </strong>

                            <div class="text-muted mt-1">

                                <%= listing.maxGuests %>

                                guests

                            </div>

                        </div>

                    </div>


                    <!-- BEDROOMS -->

                    <% if (
                        listing.bedrooms !== undefined
                    ) { %>

                        <div class="col-md-6">

                            <div
                                class="
                                    border
                                    rounded-4
                                    p-3
                                    h-100
                                "
                            >

                                🛏️

                                <strong>
                                    Bedrooms
                                </strong>

                                <div class="text-muted mt-1">

                                    <%= listing.bedrooms %>

                                </div>

                            </div>

                        </div>

                    <% } %>


                    <!-- BEDS -->

                    <% if (
                        listing.beds !== undefined
                    ) { %>

                        <div class="col-md-6">

                            <div
                                class="
                                    border
                                    rounded-4
                                    p-3
                                    h-100
                                "
                            >

                                🛏️

                                <strong>
                                    Beds
                                </strong>

                                <div class="text-muted mt-1">

                                    <%= listing.beds %>

                                </div>

                            </div>

                        </div>

                    <% } %>


                    <!-- BATHROOMS -->

                    <% if (
                        listing.bathrooms !== undefined
                    ) { %>

                        <div class="col-md-6">

                            <div
                                class="
                                    border
                                    rounded-4
                                    p-3
                                    h-100
                                "
                            >

                                🛁

                                <strong>
                                    Bathrooms
                                </strong>

                                <div class="text-muted mt-1">

                                    <%= listing.bathrooms %>

                                </div>

                            </div>

                        </div>

                    <% } %>


                    <!-- CHECK IN -->

                    <% if (
                        listing.checkInTime
                    ) { %>

                        <div class="col-md-6">

                            <div
                                class="
                                    border
                                    rounded-4
                                    p-3
                                    h-100
                                "
                            >

                                🕐

                                <strong>
                                    Check-in
                                </strong>

                                <div class="text-muted mt-1">

                                    <%= listing.checkInTime %>

                                </div>

                            </div>

                        </div>

                    <% } %>


                    <!-- CHECK OUT -->

                    <% if (
                        listing.checkOutTime
                    ) { %>

                        <div class="col-md-6">

                            <div
                                class="
                                    border
                                    rounded-4
                                    p-3
                                    h-100
                                "
                            >

                                🕐

                                <strong>
                                    Check-out
                                </strong>

                                <div class="text-muted mt-1">

                                    <%= listing.checkOutTime %>

                                </div>

                            </div>

                        </div>

                    <% } %>


                </div>

            </div>


            <!-- ==================================================
                 AMENITIES
            ================================================== -->

            <% if (
                listing.amenities &&
                listing.amenities.length > 0
            ) { %>

                <div class="mb-5">

                    <h3 class="fw-bold mb-4">

                        Amenities

                    </h3>


                    <div
                        class="
                            d-flex
                            flex-wrap
                            gap-2
                        "
                    >

                        <% listing.amenities.forEach(
                            amenity => {
                        %>

                            <span
                                class="
                                    badge
                                    text-bg-light
                                    border
                                    rounded-pill
                                    px-3
                                    py-2
                                "
                            >

                                ✓

                                <%= amenity %>

                            </span>

                        <% }) %>

                    </div>

                </div>

            <% } %>


            <!-- ==================================================
                 WEATHER
            ================================================== -->

            <div class="mb-5">

                <div
                    class="
                        d-flex
                        justify-content-between
                        align-items-center
                        mb-3
                    "
                >

                    <div>

                        <h3 class="fw-bold mb-1">

                            Weather at this destination

                        </h3>


                        <p class="text-muted mb-0">

                            📍

                            <%= listing.location %>,
                            <%= listing.country %>

                        </p>

                    </div>


                    <span
                        class="
                            badge
                            text-bg-light
                            rounded-pill
                            px-3
                            py-2
                        "
                    >

                        7-day forecast

                    </span>

                </div>


                <% if (
                    weather &&
                    weather.daily &&
                    weather.daily.time &&
                    weather.daily.time.length > 0
                ) { %>


                    <div class="row g-3">


                        <% weather.daily.time.forEach(
                            (date, index) => {
                        %>


                            <div
                                class="
                                    col-6
                                    col-md-4
                                    col-lg-3
                                "
                            >

                                <div
                                    class="
                                        card
                                        border-0
                                        shadow-sm
                                        h-100
                                    "
                                    style="
                                        border-radius:16px;
                                    "
                                >

                                    <div class="card-body">


                                        <!-- DATE -->

                                        <div
                                            class="
                                                small
                                                text-muted
                                                mb-2
                                            "
                                        >

                                            <%= new Date(
                                                date +
                                                "T00:00:00"
                                            ).toLocaleDateString(
                                                "en-IN",
                                                {
                                                    weekday:
                                                        "short",

                                                    day:
                                                        "numeric",

                                                    month:
                                                        "short"
                                                }
                                            ) %>

                                        </div>


                                        <!-- DESCRIPTION -->

                                        <div
                                            class="
                                                fw-semibold
                                                mb-2
                                            "
                                        >

                                            <%= getWeatherDescription(
                                                weather.daily.weather_code[index]
                                            ) %>

                                        </div>


                                        <!-- TEMPERATURE -->

                                        <div
                                            class="
                                                fs-5
                                                fw-bold
                                            "
                                        >

                                            <%= Math.round(
                                                weather
                                                    .daily
                                                    .temperature_2m_max[index]
                                            ) %>°C

                                            <span
                                                class="
                                                    text-muted
                                                    fw-normal
                                                "
                                            >

                                                /

                                                <%= Math.round(
                                                    weather
                                                        .daily
                                                        .temperature_2m_min[index]
                                                ) %>°C

                                            </span>

                                        </div>


                                        <!-- RAIN -->

                                        <div
                                            class="
                                                small
                                                text-muted
                                                mt-2
                                            "
                                        >

                                            🌧️

                                            <%= weather
                                                .daily
                                                .precipitation_probability_max[index] || 0
                                            %>%

                                            rain

                                        </div>


                                        <!-- WIND -->

                                        <div
                                            class="
                                                small
                                                text-muted
                                                mt-1
                                            "
                                        >

                                            💨

                                            <%= Math.round(
                                                weather
                                                    .daily
                                                    .wind_speed_10m_max[index]
                                            ) %>

                                            km/h

                                        </div>


                                    </div>

                                </div>

                            </div>


                        <% }) %>


                    </div>


                <% } else { %>


                    <div
                        class="
                            border
                            rounded-4
                            p-4
                            text-center
                            bg-light
                        "
                    >

                        <div class="fs-1 mb-2">

                            🌦️

                        </div>


                        <h5 class="fw-bold">

                            Weather unavailable

                        </h5>


                        <p class="text-muted mb-0">

                            We couldn't load weather
                            data for this destination.

                        </p>

                    </div>

                <% } %>

            </div>


            <!-- ==================================================
                 MAP
            ================================================== -->

            <div class="mb-5">

                <h3 class="fw-bold mb-2">

                    Where you'll be

                </h3>


                <p class="text-muted">

                    📍

                    <%= listing.location %>,
                    <%= listing.country %>

                </p>


                <div
                    id="map"
                    style="
                        height:450px;
                        width:100%;
                        border-radius:20px;
                        overflow:hidden;
                        border:1px solid #ddd;
                    "
                ></div>

            </div>


            <!-- ==================================================
                 REVIEWS
            ================================================== -->

            <div class="mb-5">

                <h3 class="fw-bold mb-4">

                    Reviews

                </h3>


                <% if (
                    listing.reviews &&
                    listing.reviews.length > 0
                ) { %>


                    <div class="row g-4">


                        <% listing.reviews.forEach(
                            review => {
                        %>


                            <div class="col-md-6">

                                <div
                                    class="
                                        card
                                        border-0
                                        shadow-sm
                                        h-100
                                    "
                                >

                                    <div class="card-body">


                                        <div
                                            class="
                                                d-flex
                                                justify-content-between
                                            "
                                        >

                                            <strong>

                                                👤

                                                <%= review.author
                                                    ? review.author.username
                                                    : "User"
                                                %>

                                            </strong>


                                            <span>

                                                <% for (
                                                    let i = 1;
                                                    i <= 5;
                                                    i++
                                                ) { %>

                                                    <% if (
                                                        i <= review.rating
                                                    ) { %>

                                                        ⭐

                                                    <% } else { %>

                                                        ☆

                                                    <% } %>

                                                <% } %>

                                            </span>

                                        </div>


                                        <p
                                            class="
                                                text-muted
                                                mt-3
                                            "
                                        >

                                            <%= review.comment %>

                                        </p>


                                        <% if (
                                            currentUser &&
                                            review.author &&
                                            review.author._id.toString() ===
                                            currentUser._id.toString()
                                        ) { %>

                                            <form
                                                action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                                method="POST"
                                            >

                                                <button
                                                    type="submit"
                                                    class="
                                                        btn
                                                        btn-sm
                                                        btn-outline-danger
                                                    "
                                                >

                                                    Delete

                                                </button>

                                            </form>

                                        <% } %>


                                    </div>

                                </div>

                            </div>


                        <% }) %>


                    </div>


                <% } else { %>


                    <div
                        class="
                            border
                            rounded-4
                            p-4
                            text-center
                        "
                    >

                        <p class="text-muted mb-0">

                            No reviews yet.

                        </p>

                    </div>


                <% } %>

            </div>


            <!-- ==================================================
                 ADD REVIEW
            ================================================== -->

            <% if (currentUser) { %>

                <div class="mb-5">

                    <h3 class="fw-bold mb-4">

                        Leave a Review

                    </h3>


                    <form
                        action="/listing/<%= listing._id %>/reviews"
                        method="POST"
                    >

                        <div class="mb-3">

                            <label
                                for="rating"
                                class="form-label fw-semibold"
                            >

                                Rating

                            </label>


                            <select
                                id="rating"
                                name="review[rating]"
                                class="form-select"
                                required
                            >

                                <option value="">

                                    Select rating

                                </option>

                                <option value="5">
                                    ⭐⭐⭐⭐⭐ 5
                                </option>

                                <option value="4">
                                    ⭐⭐⭐⭐ 4
                                </option>

                                <option value="3">
                                    ⭐⭐⭐ 3
                                </option>

                                <option value="2">
                                    ⭐⭐ 2
                                </option>

                                <option value="1">
                                    ⭐ 1
                                </option>

                            </select>

                        </div>


                        <div class="mb-3">

                            <label
                                for="comment"
                                class="form-label fw-semibold"
                            >

                                Comment

                            </label>


                            <textarea
                                id="comment"
                                name="review[comment]"
                                class="form-control"
                                rows="5"
                                required
                            ></textarea>

                        </div>


                        <button
                            type="submit"
                            class="
                                btn
                                btn-dark
                                rounded-pill
                                px-4
                            "
                        >

                            Submit Review

                        </button>

                    </form>

                </div>

            <% } %>


        </div>


        <!-- ==================================================
             BOOKING CARD
        ================================================== -->

        <div class="col-lg-4">

            <div
                class="
                    card
                    border-0
                    shadow-lg
                    sticky-top
                "
                style="
                    top:100px;
                    border-radius:20px;
                "
            >

                <div class="card-body p-4">


                    <div class="mb-4">

                        <span class="fs-2 fw-bold">

                            ₹<%= listing.price %>

                        </span>

                        <span class="text-muted">

                            / night

                        </span>

                    </div>


                    <div
                        class="
                            border
                            rounded-4
                            p-3
                            mb-3
                        "
                    >

                        <small class="text-muted">

                            LOCATION

                        </small>


                        <div class="fw-semibold">

                            <%= listing.location %>,
                            <%= listing.country %>

                        </div>

                    </div>


                    <div
                        class="
                            border
                            rounded-4
                            p-3
                            mb-4
                        "
                    >

                        <small class="text-muted">

                            GUESTS

                        </small>


                        <div class="fw-semibold">

                            Up to
                            <%= listing.maxGuests %>
                            guests

                        </div>

                    </div>


                    <% if (currentUser) { %>

                        <a
                            href="/listing/<%= listing._id %>/reserve"
                            class="
                                btn
                                btn-dark
                                w-100
                                py-3
                                rounded-pill
                            "
                        >

                            Reserve

                        </a>

                    <% } else { %>

                        <a
                            href="/login"
                            class="
                                btn
                                btn-dark
                                w-100
                                py-3
                                rounded-pill
                            "
                        >

                            Login to Reserve

                        </a>

                    <% } %>


                    <p
                        class="
                            text-center
                            text-muted
                            small
                            mt-3
                            mb-0
                        "
                    >

                        You won't be charged yet.

                    </p>


                </div>

            </div>

        </div>


    </div>


    <!-- ==================================================
         OWNER ACTIONS
    ================================================== -->

    <% if (
        currentUser &&
        listing.owner &&
        listing.owner._id.toString() ===
        currentUser._id.toString()
    ) { %>


        <div
            class="
                border-top
                mt-5
                pt-4
            "
        >

            <h4 class="fw-bold mb-3">

                Manage Listing

            </h4>


            <div
                class="
                    d-flex
                    gap-2
                "
            >

                <a
                    href="/listing/<%= listing._id %>/edit"
                    class="
                        btn
                        btn-outline-dark
                    "
                >

                    Edit Listing

                </a>


                <form
                    action="/listing/<%= listing._id %>?_method=DELETE"
                    method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this listing?');"
                >

                    <button
                        type="submit"
                        class="
                            btn
                            btn-outline-danger
                        "
                    >

                        Delete Listing

                    </button>

                </form>

            </div>

        </div>

    <% } %>


</div>


<!-- ==================================================
     LEAFLET CSS
================================================== -->

<link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>


<!-- ==================================================
     LEAFLET JS
================================================== -->

<script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
></script>


<!-- ==================================================
     COORDINATES
     
     IMPORTANT:
     We DO NOT put EJS JavaScript
     directly inside a JS variable.

     Instead we store JSON as text.
================================================== -->

<script
    id="listing-coordinates"
    type="application/json"
>
<%= JSON.stringify(coordinates || null) %>
</script>


<!-- ==================================================
     MAP SCRIPT
================================================== -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        // ==========================================
        // GET MAP
        // ==========================================

        const mapElement =
            document.getElementById(
                "map"
            );


        if (!mapElement) {

            return;

        }


        // ==========================================
        // GET COORDINATES SAFELY
        // ==========================================

        const coordinateElement =
            document.getElementById(
                "listing-coordinates"
            );


        if (!coordinateElement) {

            showMapError();

            return;

        }


        // ==========================================
        // READ JSON
        // ==========================================

        let coordinates =
            null;


        try {

            coordinates =
                JSON.parse(
                    coordinateElement.textContent.trim()
                );

        } catch (error) {

            console.error(
                "Could not parse coordinates:",
                error
            );


            showMapError();

            return;

        }


        // ==========================================
        // VALIDATE
        // ==========================================

        const validCoordinates =

            Array.isArray(
                coordinates
            ) &&

            coordinates.length === 2 &&

            Number.isFinite(
                Number(
                    coordinates[0]
                )
            ) &&

            Number.isFinite(
                Number(
                    coordinates[1]
                )
            ) &&

            !(
                Number(
                    coordinates[0]
                ) === 0 &&

                Number(
                    coordinates[1]
                ) === 0
            );


        if (!validCoordinates) {

            showMapError();

            return;

        }


        // ==========================================
        // GEOJSON FORMAT
        //
        // MongoDB:
        //
        // [longitude, latitude]
        //
        // Leaflet:
        //
        // [latitude, longitude]
        // ==========================================

        const longitude =
            Number(
                coordinates[0]
            );


        const latitude =
            Number(
                coordinates[1]
            );


        // ==========================================
        // CREATE MAP
        // ==========================================

        const map =
            L.map(
                "map"
            ).setView(

                [
                    latitude,
                    longitude
                ],

                13

            );


        // ==========================================
        // OPENSTREETMAP
        // ==========================================

        L.tileLayer(

            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",

            {

                maxZoom: 19,

                attribution:
                    '&copy; OpenStreetMap contributors'

            }

        ).addTo(
            map
        );


        // ==========================================
        // MARKER
        // ==========================================

        const marker =
            L.marker(

                [
                    latitude,
                    longitude
                ]

            ).addTo(
                map
            );


        // ==========================================
        // POPUP
        // ==========================================

        marker.bindPopup(`

            <div>

                <strong>
                    <%= listing.title %>
                </strong>

                <br>

                <span>
                    📍
                    <%= listing.location %>,
                    <%= listing.country %>
                </span>

                <br>

                <strong>
                    ₹<%= listing.price %>
                </strong>

                / night

            </div>

        `);


        marker.openPopup();


        // ==========================================
        // FIX MAP SIZE
        // ==========================================

        setTimeout(
            function () {

                map.invalidateSize();

            },
            300
        );


    }
);


// ==================================================
// MAP ERROR FUNCTION
// ==================================================

function showMapError() {

    const mapElement =
        document.getElementById(
            "map"
        );


    if (!mapElement) {

        return;

    }


    mapElement.innerHTML = `

        <div
            style="

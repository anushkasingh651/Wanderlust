                        required
                    ></textarea>

                </div>

            </div>


            <!-- ========================================= -->
            <!-- 4. LOCATION -->
            <!-- ========================================= -->

            <div class="section-card">

                <div class="section-title">

                    <div class="section-number">
                        4
                    </div>

                    <div>

                        <h3>Where is your place?</h3>

                        <p>
                            We'll automatically locate it on the map.
                        </p>

                    </div>

                </div>


                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="input-label">
                            City / Location
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="location"
                            name="listing[location]"
                            placeholder="Jaipur"
                            required
                        >

                    </div>


                    <div class="col-md-6 mb-3">

                        <label class="input-label">
                            Country
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="country"
                            name="listing[country]"
                            placeholder="India"
                            required
                        >

                    </div>

                </div>


                <div
                    id="previewMap"
                ></div>

            </div>


            <!-- ========================================= -->
            <!-- 5. PROPERTY DETAILS -->
            <!-- ========================================= -->

            <div class="section-card">

                <div class="section-title">

                    <div class="section-number">
                        5
                    </div>

                    <div>

                        <h3>Make guests feel at home</h3>

                        <p>
                            Tell guests how many people your property can comfortably host.
                        </p>

                    </div>

                </div>


                <div class="row">


                    <div class="col-md-3 mb-3">

                        <label class="input-label">
                            👥 Guests
                        </label>

                        <input
                            type="number"
                            class="form-control"
                            name="listing[maxGuests]"
                            value="2"
                            min="1"
                            max="20"
                            required
                        >

                    </div>


                    <div class="col-md-3 mb-3">

                        <label class="input-label">
                            🛏️ Bedrooms
                        </label>

                        <input
                            type="number"
                            class="form-control"
                            name="listing[bedrooms]"
                            value="1"
                            min="0"
                            max="20"
                        >

                    </div>


                    <div class="col-md-3 mb-3">

                        <label class="input-label">
                            🛌 Beds
                        </label>

                        <input
                            type="number"
                            class="form-control"
                            name="listing[beds]"
                            value="1"
                            min="0"
                            max="30"
                        >

                    </div>


                    <div class="col-md-3 mb-3">

                        <label class="input-label">
                            🚿 Bathrooms
                        </label>

                        <input
                            type="number"
                            class="form-control"
                            name="listing[bathrooms]"
                            value="1"
                            min="0"
                            max="20"
                        >

                    </div>

                </div>

            </div>


            <!-- ========================================= -->
            <!-- 6. AMENITIES -->
            <!-- ========================================= -->

            <div class="section-card">

                <div class="section-title">

                    <div class="section-number">
                        6
                    </div>

                    <div>

                        <h3>What does your place offer?</h3>

                        <p>
                            Select everything guests can use.
                        </p>

                    </div>

                </div>


                <div class="amenities-grid">


                    <label class="amenity">

                        <input
                            type="checkbox"
                            name="listing[amenities][]"
                            value="WiFi"
                        >

                        📶 Wi-Fi

                    </label>


                    <label class="amenity">

                        <input
                            type="checkbox"
                            name="listing[amenities][]"
                            value="Air Conditioning"
                        >

                        ❄️ Air Conditioning

                    </label>


                    <label class="amenity">

                        <input
                            type="checkbox"
                            name="listing[amenities][]"
                            value="Kitchen"
                        >

                        🍳 Kitchen

                    </label>


                    <label class="amenity">

                        <input
                            type="checkbox"
                            name="listing[amenities][]"
                            value="Parking"
                        >

                        🚗 Free Parking

                    </label>


                    <label class="amenity">

                        <input
                            type="checkbox"
                            name="listing[amenities][]"
                            value="Pool"
                        >

                        🏊 Swimming Pool

                    </label>


                    <label class="amenity">

                        <input
                            type="checkbox"
                            name="listing[amenities][]"
                            value="TV"
                        >

                        📺 TV

                    </label>


                    <label class="amenity">

                        <input
                            type="checkbox"
                            name="listing[amenities][]"
                            value="Workspace"
                        >

                        💻 Workspace

                    </label>


                    <label class="amenity">

                        <input
                            type="checkbox"
                            name="listing[amenities][]"
                            value="Washer"
                        >

                        🧺 Washer

                    </label>


                    <label class="amenity">

                        <input
                            type="checkbox"
                            name="listing[amenities][]"
                            value="Balcony"

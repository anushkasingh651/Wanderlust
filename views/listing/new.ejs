<% layout("layouts/boilerplate") %>

<style>

    .create-page {
        background: #f7f7f7;
        min-height: 100vh;
        padding: 45px 0 80px;
    }

    .create-header {
        margin-bottom: 35px;
    }

    .create-header h1 {
        font-size: 2.4rem;
        font-weight: 700;
        color: #222;
    }

    .create-header p {
        color: #777;
        font-size: 1.05rem;
    }

    .section-card {
        background: white;
        border-radius: 22px;
        padding: 30px;
        margin-bottom: 25px;
        border: 1px solid #e9e9e9;
        box-shadow: 0 5px 20px rgba(0,0,0,0.04);
    }

    .section-number {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #111;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin-right: 12px;
    }

    .section-title {
        display: flex;
        align-items: center;
        margin-bottom: 25px;
    }

    .section-title h3 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 700;
    }

    .section-title p {
        margin: 3px 0 0;
        color: #888;
        font-size: 0.9rem;
    }

    /* PROPERTY TYPE */

    .property-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }

    .property-option {
        position: relative;
    }

    .property-option input {
        position: absolute;
        opacity: 0;
    }

    .property-card {
        border: 2px solid #e5e5e5;
        border-radius: 16px;
        padding: 20px 10px;
        text-align: center;
        cursor: pointer;
        transition: 0.2s;
    }

    .property-card:hover {
        border-color: #111;
        transform: translateY(-2px);
    }

    .property-option input:checked + .property-card {
        border-color: #111;
        background: #f5f5f5;
    }

    .property-icon {
        font-size: 30px;
        margin-bottom: 8px;
    }

    .property-name {
        font-weight: 600;
        font-size: 0.9rem;
    }

    /* IMAGE UPLOAD */

    .upload-box {
        border: 2px dashed #bbb;
        border-radius: 20px;
        padding: 45px 20px;
        text-align: center;
        cursor: pointer;
        transition: 0.2s;
    }

    .upload-box:hover {
        border-color: #111;
        background: #fafafa;
    }

    .upload-icon {
        font-size: 42px;
        margin-bottom: 10px;
    }

    .upload-box h4 {
        font-weight: 700;
    }

    .upload-box p {
        color: #888;
        margin-bottom: 5px;
    }

    #imagePreview {
        display: none;
        width: 100%;
        max-height: 400px;
        object-fit: cover;
        border-radius: 18px;
        margin-top: 20px;
    }

    /* INPUTS */

    .form-control,
    .form-select {
        min-height: 50px;
        border-radius: 12px;
        border: 1px solid #ddd;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #111;
        box-shadow: 0 0 0 3px rgba(0,0,0,0.07);
    }

    textarea.form-control {
        min-height: 140px;
    }

    .input-label {
        font-weight: 600;
        margin-bottom: 8px;
    }

    /* AMENITIES */

    .amenities-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .amenity {
        border: 1px solid #ddd;
        border-radius: 12px;
        padding: 13px;
        cursor: pointer;
        transition: 0.2s;
    }

    .amenity:hover {
        border-color: #111;
    }

    .amenity input {
        margin-right: 8px;
    }

    /* GUEST COUNTER */

    .counter-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1px solid #ddd;
        border-radius: 14px;
        padding: 15px 18px;
    }

    .counter-box strong {
        font-size: 1.1rem;
    }

    /* MAP */

    #previewMap {
        height: 330px;
        border-radius: 18px;
        margin-top: 20px;
        display: none;
    }

    /* SUBMIT */

    .publish-box {
        position: sticky;
        bottom: 20px;
        background: white;
        border-radius: 18px;
        padding: 18px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.12);
        border: 1px solid #eee;
    }

    .publish-btn {
        width: 100%;
        border-radius: 12px;
        min-height: 55px;
        font-size: 1.05rem;
        font-weight: 700;
    }

    @media (max-width: 768px) {

        .property-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .amenities-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .section-card {
            padding: 20px;
        }

    }

</style>


<div class="create-page">

    <div class="container">

        <!-- HEADER -->

        <div class="create-header">

            <h1>✨ Create your stay</h1>

            <p>
                Turn your space into a place people remember.
            </p>

        </div>


        <form
            action="/listing"
            method="POST"
            enctype="multipart/form-data"
            id="listingForm"
        >


            <!-- ========================================= -->
            <!-- 1. PROPERTY TYPE -->
            <!-- ========================================= -->

            <div class="section-card">

                <div class="section-title">

                    <div class="section-number">
                        1
                    </div>

                    <div>

                        <h3>What kind of place is it?</h3>

                        <p>
                            Choose the category that best describes your property.
                        </p>

                    </div>

                </div>


                <div class="property-grid">


                    <label class="property-option">

                        <input
                            type="radio"
                            name="listing[propertyType]"
                            value="Apartment"
                            required
                        >

                        <div class="property-card">

                            <div class="property-icon">
                                🏢
                            </div>

                            <div class="property-name">
                                Apartment
                            </div>

                        </div>

                    </label>


                    <label class="property-option">

                        <input
                            type="radio"
                            name="listing[propertyType]"
                            value="Villa"
                        >

                        <div class="property-card">

                            <div class="property-icon">
                                🏡
                            </div>

                            <div class="property-name">
                                Villa
                            </div>

                        </div>

                    </label>


                    <label class="property-option">

                        <input
                            type="radio"
                            name="listing[propertyType]"
                            value="House"
                        >

                        <div class="property-card">

                            <div class="property-icon">
                                🏠
                            </div>

                            <div class="property-name">
                                House
                            </div>

                        </div>

                    </label>


                    <label class="property-option">

                        <input
                            type="radio"
                            name="listing[propertyType]"
                            value="Hotel"
                        >

                        <div class="property-card">

                            <div class="property-icon">
                                🏨
                            </div>

                            <div class="property-name">
                                Hotel
                            </div>

                        </div>

                    </label>


                    <label class="property-option">

                        <input
                            type="radio"
                            name="listing[propertyType]"
                            value="Cabin"
                        >

                        <div class="property-card">

                            <div class="property-icon">
                                🌲
                            </div>

                            <div class="property-name">
                                Cabin
                            </div>

                        </div>

                    </label>


                    <label class="property-option">

                        <input
                            type="radio"
                            name="listing[propertyType]"
                            value="Farmhouse"
                        >

                        <div class="property-card">

                            <div class="property-icon">
                                🌾
                            </div>

                            <div class="property-name">
                                Farmhouse
                            </div>

                        </div>

                    </label>


                    <label class="property-option">

                        <input
                            type="radio"
                            name="listing[propertyType]"
                            value="Other"
                        >

                        <div class="property-card">

                            <div class="property-icon">
                                ✨
                            </div>

                            <div class="property-name">
                                Other
                            </div>

                        </div>

                    </label>

                </div>

            </div>


            <!-- ========================================= -->
            <!-- 2. IMAGE -->
            <!-- ========================================= -->

            <div class="section-card">

                <div class="section-title">

                    <div class="section-number">
                        2
                    </div>

                    <div>

                        <h3>Showcase your space</h3>

                        <p>
                            Great photos help guests imagine themselves there.
                        </p>

                    </div>

                </div>


                <label
                    for="image"
                    class="upload-box"
                >

                    <div class="upload-icon">
                        📸
                    </div>

                    <h4>
                        Upload your property photo
                    </h4>

                    <p>
                        Click here to choose an image

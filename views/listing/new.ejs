            <!-- ========================================= -->
            <!-- PUBLISH -->
            <!-- ========================================= -->

            <div class="publish-box">

                <div class="row align-items-center">

                    <div class="col-md-8">

                        <strong>
                            Ready to welcome travellers? 🚀
                        </strong>

                        <div class="text-muted small">
                            Your listing will appear on Wanderlust immediately.
                        </div>

                    </div>


                    <div class="col-md-4 mt-3 mt-md-0">

                        <button
                            type="submit"
                            class="btn btn-dark publish-btn"
                        >

                            <i class="fa-solid fa-rocket"></i>

                            Publish Listing

                        </button>

                    </div>

                </div>

            </div>


        </form>

    </div>

</div>


<!-- ========================================= -->
<!-- LEAFLET -->
<!-- ========================================= -->

<link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
></script>


<script>

    // =========================================
    // IMAGE PREVIEW
    // =========================================

    const imageInput =
        document.getElementById("image");

    const imagePreview =
        document.getElementById("imagePreview");


    imageInput.addEventListener(
        "change",
        function () {

            const file =
                this.files[0];

            if (!file) {
                return;
            }

            const reader =
                new FileReader();

            reader.onload =
                function (event) {

                    imagePreview.src =
                        event.target.result;

                    imagePreview.style.display =
                        "block";
                };

            reader.readAsDataURL(file);

        }
    );


    // =========================================
    // LOCATION PREVIEW
    // =========================================

    const locationInput =
        document.getElementById("location");

    const countryInput =
        document.getElementById("country");

    const previewMap =
        document.getElementById("previewMap");

    let map = null;


    async function updatePreviewMap() {

        const location =
            locationInput.value.trim();

        const country =
            countryInput.value.trim();


        if (
            location.length < 3 ||
            country.length < 2
        ) {

            return;
        }


        try {

            const query =
                encodeURIComponent(
                    `${location}, ${country}`
                );


            const response =
                await fetch(
                    `https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${query}`,
                    {
                        headers: {
                            "Accept":
                                "application/json"
                        }
                    }
                );


            const data =
                await response.json();


            if (
                !data ||
                data.length === 0
            ) {

                return;
            }


            const latitude =
                parseFloat(
                    data[0].lat
                );

            const longitude =
                parseFloat(
                    data[0].lon
                );


            previewMap.style.display =
                "block";


            if (!map) {

                map =
                    L.map(
                        "previewMap"
                    ).setView(
                        [
                            latitude,
                            longitude
                        ],
                        12
                    );


                L.tileLayer(
                    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                    {
                        attribution:
                            "&copy; OpenStreetMap contributors"
                    }
                ).addTo(map);

            } else {

                map.setView(
                    [
                        latitude,
                        longitude
                    ],
                    12
                );

            }


            L.marker(
                [
                    latitude,
                    longitude
                ]
            )
            .addTo(map)
            .bindPopup(
                `<strong>${location}</strong><br>${country}`
            )
            .openPopup();


        } catch (error) {

            console.log(
                "Map preview error:",
                error
            );

        }

    }


    let locationTimer;


    function scheduleMapUpdate() {

        clearTimeout(
            locationTimer
        );

        locationTimer =
            setTimeout(
                updatePreviewMap,
                800
            );

    }


    locationInput.addEventListener(
        "input",
        scheduleMapUpdate
    );


    countryInput.addEventListener(
        "input",
        scheduleMapUpdate
    );


</script>
            </div>


            <!-- ========================================= -->
            <!-- 3. STORY -->
            <!-- ========================================= -->

            <div class="section-card">

                <div class="section-title">

                    <div class="section-number">
                        3
                    </div>

                    <div>

                        <h3>Tell your property's story</h3>

                        <p>
                            Give travellers a reason to choose your place.
                        </p>

                    </div>

                </div>


                <div class="mb-4">

                    <label class="input-label">
                        Property title
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        name="listing[title]"

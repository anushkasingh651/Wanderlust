<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Wanderlust</title>


    <!-- ==================================================
         BOOTSTRAP
    =================================================== -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- ==================================================
         FONT AWESOME
    =================================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >


    <!-- ==================================================
         YOUR CSS
    =================================================== -->

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>


    <!-- ==================================================
         NAVBAR
    =================================================== -->

    <nav
        class="navbar navbar-expand-lg bg-white border-bottom sticky-top"
    >

        <div class="container">


            <!-- ==================================================
                 LOGO
            =================================================== -->

            <a
                class="navbar-brand fw-bold"
                href="/listing"
            >

                <i class="fa-solid fa-compass me-2"></i>

                Wanderlust

            </a>


            <!-- ==================================================
                 MOBILE MENU BUTTON
            =================================================== -->

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
                aria-controls="navbarNav"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- ==================================================
                 NAVIGATION
            =================================================== -->

            <div
                class="collapse navbar-collapse"
                id="navbarNav"
            >

                <ul
                    class="navbar-nav ms-auto align-items-lg-center"
                >


                    <!-- ==================================================
                         EXPLORE
                    ================================================== -->

                    <li class="nav-item">

                        <a
                            class="nav-link"
                            href="/listing"
                        >

                            <i
                                class="fa-solid fa-magnifying-glass me-1"
                            ></i>

                            Explore

                        </a>

                    </li>


                    <!-- ==================================================
                         AI TRIP PLANNER
                    ================================================== -->

                    <li class="nav-item">

                        <a
                            class="nav-link"
                            href="/ai-travel"
                        >

                            <i
                                class="fa-solid fa-wand-magic-sparkles me-1"
                            ></i>

                            AI Trip Planner

                        </a>

                    </li>


                    <% if (currentUser) { %>


                        <!-- ==================================================
                             DASHBOARD
                        ================================================== -->

                        <li class="nav-item">

                            <a
                                class="nav-link"
                                href="/dashboard"
                            >

                                <i
                                    class="fa-solid fa-user me-1"
                                ></i>

                                Dashboard

                            </a>

                        </li>


                        <!-- ==================================================
                             WISHLIST
                             Wishlist is inside dashboard
                        ================================================== -->

                        <li class="nav-item">

                            <a
                                class="nav-link"
                                href="/dashboard"
                            >

                                <i
                                    class="fa-solid fa-heart me-1"
                                ></i>

                                Wishlist

                            </a>

                        </li>


                        <!-- ==================================================
                             ADD LISTING
                        ================================================== -->

                        <li class="nav-item">

                            <a
                                class="nav-link"
                                href="/listing/new"
                            >

                                <i
                                    class="fa-solid fa-plus me-1"
                                ></i>

                                Add Listing

                            </a>

                        </li>


                        <!-- ==================================================
                             LOGOUT
                        ================================================== -->

                        <li class="nav-item ms-lg-2">

                            <a
                                class="btn btn-outline-dark btn-sm"
                                href="/logout"
                            >

                                <i
                                    class="fa-solid fa-right-from-bracket me-1"
                                ></i>

                                Logout

                            </a>

                        </li>


                    <% } else { %>


                        <!-- ==================================================
                             LOGIN
                        ================================================== -->

                        <li class="nav-item">

                            <a
                                class="nav-link"
                                href="/login"
                            >

                                <i
                                    class="fa-solid fa-right-to-bracket me-1"
                                ></i>

                                Login

                            </a>

                        </li>


                        <!-- ==================================================
                             SIGN UP
                        ================================================== -->

                        <li class="nav-item ms-lg-2">

                            <a
                                class="btn btn-dark btn-sm"
                                href="/signup"
                            >

                                Sign Up

                            </a>

                        </li>


                    <% } %>


                </ul>

            </div>

        </div>

    </nav>


    <!-- ==================================================
         FLASH MESSAGES
    ================================================== -->

    <div class="container mt-3">


        <!-- SUCCESS -->

        <% if (success && success.length) { %>

            <div
                class="alert alert-success alert-dismissible fade show"
                role="alert"
            >

                <i
                    class="fa-solid fa-circle-check me-2"
                ></i>

                <%= success %>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"
                ></button>

            </div>

        <% } %>


        <!-- ERROR -->

        <% if (error && error.length) { %>

            <div
                class="alert alert-danger alert-dismissible fade show"
                role="alert"
            >

                <i
                    class="fa-solid fa-circle-exclamation me-2"
                ></i>

                <%= error %>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"
                ></button>

            </div>

        <% } %>


        <!-- INFO -->

        <% if (info && info.length) { %>

            <div
                class="alert alert-info alert-dismissible fade show"
                role="alert"
            >

                <i
                    class="fa-solid fa-circle-info me-2"
                ></i>

                <%= info %>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"
                ></button>

            </div>

        <% } %>


    </div>


    <!-- ==================================================
         PAGE CONTENT
    ================================================== -->

    <main>

        <%- body %>

    </main>


    <!-- ==================================================
         FOOTER
    ================================================== -->

    <footer class="border-top mt-5 py-4">

        <div class="container">

            <div class="row">


                <!-- ==================================================
                     ABOUT
                ================================================== -->

                <div class="col-md-6">

                    <h5 class="fw-bold">

                        <i
                            class="fa-solid fa-compass me-2"
                        ></i>

                        Wanderlust

                    </h5>

                    <p class="text-muted mb-0">

                        Discover unique stays
                        and unforgettable journeys.

                    </p>

                </div>


                <!-- ==================================================
                     FOOTER LINKS
                ================================================== -->

                <div
                    class="col-md-6 text-md-end mt-3 mt-md-0"
                >


                    <!-- EXPLORE -->

                    <a
                        href="/listing"
                        class="text-decoration-none text-dark me-3"
                    >

                        Explore

                    </a>


                    <!-- AI -->

                    <a
                        href="/ai-travel"
                        class="text-decoration-none text-dark me-3"
                    >

                        🤖 AI Trip Planner

                    </a>


                    <% if (currentUser) { %>


                        <!-- DASHBOARD -->

                        <a
                            href="/dashboard"
                            class="text-decoration-none text-dark me-3"
                        >

                            Dashboard

                        </a>


                        <!-- WISHLIST -->

                        <a
                            href="/dashboard"
                            class="text-decoration-none text-dark"
                        >

                            ❤️ Wishlist

                        </a>


                    <% } %>


                </div>

            </div>


            <hr>


            <!-- COPYRIGHT -->

            <p
                class="text-center text-muted small mb-0"
            >

                © <%= new Date().getFullYear() %>
                Wanderlust. All rights reserved.

            </p>

        </div>

    </footer>


    <!-- ==================================================
         BOOTSTRAP JS
    ================================================== -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>


</body>

</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page</title>
</head>

<body>

    <h1>Flash Messages</h1>

    <% if (messages.info && messages.info.length > 0) { %>

        <% messages.info.forEach(message => { %>

            <div>
                <%= message %>
            </div>

        <% }) %>

    <% } %>

    <h2>Welcome <%= username %></h2>

</body>
</html>